<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>CopyPasta.Core</RootNamespace>
    <!--
      Deliberately NOT net9.0-windows and deliberately free of P/Invoke.
      This assembly holds the capture rules, which must be unit-testable without a
      message loop, a clipboard, or even Windows. Win32 lives in CopyPasta.Interop.
    -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopyPasta.Core.Tests" />
  </ItemGroup>

</Project>
