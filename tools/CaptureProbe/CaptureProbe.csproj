<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <!-- The Windows SDK projection, for Windows.Media.Ocr. Runs on Windows 10 1809 and later. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CaptureProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CopyPasta.Data\CopyPasta.Data.csproj" />
    <ProjectReference Include="..\..\src\CopyPasta.Interop\CopyPasta.Interop.csproj" />
  </ItemGroup>

</Project>
